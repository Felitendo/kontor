<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kontor" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kontor_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>

    <style name="Theme.Kontor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kontor_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Kontor</item>
    </style>
</resources>
